# Copy this file to ".env" and fill in your key:   cp .env.example .env
# .env is listed in .gitignore - never commit it, and never paste your key into source code.

# Free key: https://newsapi.org/register
NEWSAPI_KEY=your_api_key_here

# Optional: DEBUG, INFO (default), WARNING or ERROR
# NEWSPULSE_LOG_LEVEL=INFO

# Optional: keep the database, exports, logs and cache somewhere other than the project folder
# NEWSPULSE_HOME=/path/to/my/newspulse-data
